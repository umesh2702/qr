# UCode Environment Configuration Template
# Copy to .env.local for local development

# Base Application URL
NEXT_PUBLIC_SITE_URL=https://ucode.app

# Analytics Configuration (Disabled by default)
# Set to 'true' to enable aggregate privacy-first client telemetry
NEXT_PUBLIC_ENABLE_ANALYTICS=false
# Optional Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Optional Custom Analytics Webhook
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Advertising Configuration (Disabled by default)
# Set to 'true' only once approved by Google AdSense or advertising partner
NEXT_PUBLIC_ENABLE_ADS=false
# Google AdSense Client Publisher ID
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Lead Dispatcher Configuration (Optional for UCreates Lead Capture)
# Webhook URL for CRM / Slack / Zapier lead ingestion
LEAD_WEBHOOK_URL=
# Resend API Key for direct email notification forwarding
RESEND_API_KEY=
# Notification recipient for inbound agency leads
LEAD_NOTIFICATION_EMAIL=umeshmedisetty@gmail.com