# ==============================================================================
# UCode Production & Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# On Vercel, configure these variables in: Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. Canonical Site URL (Required for Sitemaps, Robots.txt & OpenGraph Metadata)
# ------------------------------------------------------------------------------
# Production canonical domain: https://ucodeqr.in
# Configure in Vercel: Project Settings -> Environment Variables -> Production
NEXT_PUBLIC_SITE_URL=https://ucodeqr.in

# ------------------------------------------------------------------------------
# 2. Transactional Email & Lead Gateway (Required for /contact form delivery)
# ------------------------------------------------------------------------------
# At least ONE of RESEND_API_KEY or LEAD_WEBHOOK_URL must be configured for the
# Contact form to deliver submissions.

# Resend API Key (format: re_xxxxxxxxxxxxxxxxxxxxxxxx)
# Create a free account at https://resend.com and generate an API key.
RESEND_API_KEY=re_your_api_key_here

# Sender address for Resend.
# Resend requires the sender address to be on a domain verified in your Resend account.
# With domain 'ucodeqr.in' verified in Resend, configure:
#   RESEND_FROM_EMAIL=UCode Leads <leads@ucodeqr.in>
# IMPORTANT: Never use 'onboarding@resend.dev' in production; Resend strictly blocks
# sending from 'resend.dev' to external addresses with HTTP 403.
RESEND_FROM_EMAIL=UCode Leads <leads@ucodeqr.in>

# Recipient email address where inbound project leads are delivered:
LEAD_NOTIFICATION_EMAIL=umeshmedisetty@gmail.com

# Optional Webhook URL for CRM / Slack / Discord / Zapier / Make lead ingestion:
LEAD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 3. Privacy Analytics & Advertising (Disabled by default)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

NEXT_PUBLIC_ENABLE_ADS=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=